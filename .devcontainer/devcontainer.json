{
  "name": "My Codespace",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        // 1. 색상 테마 설정
        "workbench.colorTheme": "Default Dark+",
        // 2. 터미널 기본 프로필을 PowerShell로 설정 (리눅스 환경용)
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  },

  // 다른 VS Code 설정은 customizations으로 옮겼기 때문에
  // postCreateCommand에서 settings.json을 직접 수정하는 부분이 제거되었습니다.
  "postCreateCommand": "git lfs install && mkdir -p /root/.vscode-remote/data/Machine"
}