{
  "name": "My Codespace",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        // 1. 색상 테마 설정
        "workbench.colorTheme": "Default Dark+",
        // 2. 터미널 기본 프로필을 PowerShell로 설정 (리눅스 환경용)
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // 컨테이너 구성 직후 실행되는 명령
  "postCreateCommand": "git lfs install && mkdir -p /root/.vscode-remote/data/Machine"
}