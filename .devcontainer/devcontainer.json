{
  "name": "My Codespace",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Default Dark+"
      }
    }
  },

  "postCreateCommand": "git lfs install && mkdir -p /root/.vscode-remote/data/Machine && echo '{\"terminal.integrated.defaultProfile.linux\": \"pwsh\"}' > /root/.vscode-remote/data/Machine/settings.json"
}
